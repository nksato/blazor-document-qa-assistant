@page "/diff-upload"
@using ResponseAgent.Services
@using ResponseAgent.Components.Shared
@using static ResponseAgent.Components.Shared.Diff
@inject IFileProcessingService FileProcessingService
@rendermode InteractiveServer

<PageTitle>テキスト比較</PageTitle>

<!-- ヘッダー -->
<div class="app-header">
    <div class="container">
        <h1>
            <i class="bi bi-file-diff"></i>
            テキストファイル比較
        </h1>
        <p class="mb-0 mt-2" style="font-size: 1rem; opacity: 0.95;">
            2つのテキストファイルを比較
        </p>
    </div>
</div>

<!-- メインコンテンツ -->
<div class="container" style="padding: 1.5rem; max-width: 1200px;">
    
    <!-- ファイルアップロードセクション -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="custom-card">
                <div class="card-header-custom">
                    <h5>
                        <i class="bi bi-file-earmark-text"></i>
                        ファイル1
                    </h5>
                </div>
                <div class="card-body-custom">
                    <div class="upload-area-small mb-3">
                        <p class="text-muted mb-2">
                            <i class="bi bi-upload"></i> テキストファイル (.txt) を選択
                        </p>
                        <InputFile OnChange="HandleFile1Selected" 
                                   class="form-control" 
                                   accept=".txt" 
                                   disabled="@isProcessing" />
                    </div>
                    @if (!string.IsNullOrEmpty(file1Name))
                    {
                        <div class="alert-custom alert-success-custom">
                            <i class="bi bi-check-circle-fill"></i>
                            <div>
                                <strong>@file1Name</strong> を読み込みました
                                <br />
                                <small>@file1Content?.Length 文字</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="custom-card">
                <div class="card-header-custom">
                    <h5>
                        <i class="bi bi-file-earmark-text"></i>
                        ファイル2
                    </h5>
                </div>
                <div class="card-body-custom">
                    <div class="upload-area-small mb-3">
                        <p class="text-muted mb-2">
                            <i class="bi bi-upload"></i> テキストファイル (.txt) を選択
                        </p>
                        <InputFile OnChange="HandleFile2Selected" 
                                   class="form-control" 
                                   accept=".txt" 
                                   disabled="@isProcessing" />
                    </div>
                    @if (!string.IsNullOrEmpty(file2Name))
                    {
                        <div class="alert-custom alert-success-custom">
                            <i class="bi bi-check-circle-fill"></i>
                            <div>
                                <strong>@file2Name</strong> を読み込みました
                                <br />
                                <small>@file2Content?.Length 文字</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- エラーメッセージ -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert-custom alert-danger-custom mb-4">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>@errorMessage</div>
        </div>
    }

    <!-- 比較ボタン -->
    <div class="text-center mb-4">
        <button class="btn btn-primary-custom btn-custom btn-lg" 
                @onclick="CompareFiles" 
                disabled="@(!CanCompare)">
            <i class="bi bi-arrow-left-right"></i>
            比較する
        </button>
    </div>

    <!-- 処理中表示 -->
    @if (isProcessing)
    {
        <div class="custom-card mb-4">
            <div class="card-body-custom">
                <div class="loading-overlay">
                    <div class="spinner-custom"></div>
                    <span style="color: var(--primary-color); font-weight: 600;">比較中...</span>
                </div>
            </div>
        </div>
    }

    <!-- 比較結果 -->
    @if (diffLines != null && !isProcessing)
    {
        <div class="custom-card">
            <div class="card-header-custom">
                <h5>
                    <i class="bi bi-file-diff-fill"></i>
                    比較結果
                </h5>
            </div>
            <div class="card-body-custom">
                <div class="mb-3">
                    <span class="badge bg-danger me-2">
                        <i class="bi bi-dash-circle"></i> @removedCount 行削除
                    </span>
                    <span class="badge bg-success me-2">
                        <i class="bi bi-plus-circle"></i> @addedCount 行追加
                    </span>
                    <span class="badge bg-secondary">
                        <i class="bi bi-circle"></i> @unchangedCount 行変更なし
                    </span>
                </div>
                <Diff DiffLines="diffLines" />
            </div>
        </div>
    }
</div>

@code {
    private bool isProcessing = false;
    private string? errorMessage;
    
    private string? file1Name;
    private string? file1Content;
    
    private string? file2Name;
    private string? file2Content;
    
    private List<DiffLine>? diffLines;
    private int addedCount;
    private int removedCount;
    private int unchangedCount;

    private bool CanCompare => !string.IsNullOrEmpty(file1Content) && 
                               !string.IsNullOrEmpty(file2Content) && 
                               !isProcessing;

    private async Task HandleFile1Selected(InputFileChangeEventArgs e)
    {
        await HandleFileSelected(e, isFile1: true);
    }

    private async Task HandleFile2Selected(InputFileChangeEventArgs e)
    {
        await HandleFileSelected(e, isFile1: false);
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e, bool isFile1)
    {
        errorMessage = null;
        var file = e.File;

        if (file == null)
            return;

        // ファイルサイズチェック (5MB制限)
        const long maxFileSize = 5 * 1024 * 1024;
        if (file.Size > maxFileSize)
        {
            errorMessage = "ファイルサイズが大きすぎます。5MB以下のファイルを選択してください。";
            return;
        }

        try
        {
            isProcessing = true;
            await InvokeAsync(StateHasChanged);

            using var stream = file.OpenReadStream(maxFileSize);
            var content = await FileProcessingService.ExtractTextFromFileAsync(stream, file.Name);

            if (string.IsNullOrWhiteSpace(content))
            {
                errorMessage = "ファイルからテキストを抽出できませんでした。";
                return;
            }

            if (isFile1)
            {
                file1Name = file.Name;
                file1Content = content;
            }
            else
            {
                file2Name = file.Name;
                file2Content = content;
            }

            // 既に両方のファイルがロードされている場合は、比較結果をクリア
            if (diffLines != null)
            {
                diffLines = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"エラーが発生しました: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CompareFiles()
    {
        if (!CanCompare)
            return;

        try
        {
            isProcessing = true;
            errorMessage = null;
            await InvokeAsync(StateHasChanged);

            // 簡易的な行単位の差分計算
            diffLines = CalculateDiff(file1Content!, file2Content!);
            
            // 統計情報を計算
            addedCount = diffLines.Count(l => l.Type == DiffLineType.Added);
            removedCount = diffLines.Count(l => l.Type == DiffLineType.Removed);
            unchangedCount = diffLines.Count(l => l.Type == DiffLineType.Unchanged);
        }
        catch (Exception ex)
        {
            errorMessage = $"比較中にエラーが発生しました: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private List<DiffLine> CalculateDiff(string text1, string text2)
    {
        var lines1 = text1.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
        var lines2 = text2.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
        
        var result = new List<DiffLine>();
        
        // 簡易的なLongest Common Subsequence (LCS) アルゴリズム
        var lcs = LongestCommonSubsequence(lines1, lines2);
        
        int i = 0, j = 0, k = 0;
        
        while (i < lines1.Length || j < lines2.Length)
        {
            if (k < lcs.Count)
            {
                // 削除された行を追加
                while (i < lines1.Length && lines1[i] != lcs[k])
                {
                    result.Add(new DiffLine { Type = DiffLineType.Removed, Content = lines1[i] });
                    i++;
                }
                
                // 追加された行を追加
                while (j < lines2.Length && lines2[j] != lcs[k])
                {
                    result.Add(new DiffLine { Type = DiffLineType.Added, Content = lines2[j] });
                    j++;
                }
                
                // 共通の行を追加
                if (i < lines1.Length && j < lines2.Length)
                {
                    result.Add(new DiffLine { Type = DiffLineType.Unchanged, Content = lines1[i] });
                    i++;
                    j++;
                    k++;
                }
            }
            else
            {
                // LCSの後の残りの行を処理
                while (i < lines1.Length)
                {
                    result.Add(new DiffLine { Type = DiffLineType.Removed, Content = lines1[i] });
                    i++;
                }
                
                while (j < lines2.Length)
                {
                    result.Add(new DiffLine { Type = DiffLineType.Added, Content = lines2[j] });
                    j++;
                }
            }
        }
        
        return result;
    }

    private List<string> LongestCommonSubsequence(string[] lines1, string[] lines2)
    {
        int m = lines1.Length;
        int n = lines2.Length;
        
        var dp = new int[m + 1, n + 1];
        
        // LCSの長さを計算
        for (int i = 1; i <= m; i++)
        {
            for (int j = 1; j <= n; j++)
            {
                if (lines1[i - 1] == lines2[j - 1])
                {
                    dp[i, j] = dp[i - 1, j - 1] + 1;
                }
                else
                {
                    dp[i, j] = Math.Max(dp[i - 1, j], dp[i, j - 1]);
                }
            }
        }
        
        // LCSを逆順で構築
        var lcs = new List<string>();
        int x = m, y = n;
        
        while (x > 0 && y > 0)
        {
            if (lines1[x - 1] == lines2[y - 1])
            {
                lcs.Insert(0, lines1[x - 1]);
                x--;
                y--;
            }
            else if (dp[x - 1, y] > dp[x, y - 1])
            {
                x--;
            }
            else
            {
                y--;
            }
        }
        
        return lcs;
    }
}

@* Diff Component - テキスト差分表示コンポーネント *@

<div class="diff-container">
    @if (DiffLines != null && DiffLines.Any())
    {
        @foreach (var line in DiffLines)
        {
            <div class="diff-line @GetLineClass(line.Type)">
                <span class="diff-line-marker">@GetLineMarker(line.Type)</span>
                <span class="diff-line-content">@line.Content</span>
            </div>
        }
    }
    else
    {
        <div class="text-muted text-center p-4">
            差分がありません
        </div>
    }
</div>

@code {
    [Parameter]
    public List<DiffLine>? DiffLines { get; set; }

    private string GetLineClass(DiffLineType type)
    {
        return type switch
        {
            DiffLineType.Added => "diff-line-added",
            DiffLineType.Removed => "diff-line-removed",
            DiffLineType.Unchanged => "diff-line-unchanged",
            _ => ""
        };
    }

    private string GetLineMarker(DiffLineType type)
    {
        return type switch
        {
            DiffLineType.Added => "+",
            DiffLineType.Removed => "-",
            DiffLineType.Unchanged => " ",
            _ => " "
        };
    }

    public enum DiffLineType
    {
        Unchanged,
        Added,
        Removed
    }

    public class DiffLine
    {
        public DiffLineType Type { get; set; }
        public string Content { get; set; } = string.Empty;
    }
}

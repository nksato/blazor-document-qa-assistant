@inherits LayoutComponentBase

<div class="page">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom mb-0" style="box-shadow: var(--shadow-md);">
        <div class="container">
            <a class="navbar-brand" href="/" style="font-weight: 600; color: var(--primary-color);">
                <i class="bi bi-file-earmark-text-fill"></i>
                Document Q&A
            </a>
            <div class="navbar-nav">
                <a class="nav-link" href="/" style="color: var(--gray-700);">
                    <i class="bi bi-house-fill"></i> ホーム
                </a>
                <a class="nav-link" href="/diff-upload" style="color: var(--gray-700);">
                    <i class="bi bi-file-diff"></i> テキスト比較
                </a>
            </div>
        </div>
    </nav>
    <main>
        @Body
    </main>
    
    <footer class="footer mt-5 py-4" style="background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-color) 100%); color: white;">
        <div class="container text-center">
            <div class="mb-2">
                <i class="bi bi-building" style="font-size: 2rem;"></i>
            </div>
            <p class="mb-1" style="font-size: 0.95rem;">
                <strong>ドキュメントQ&Aアシスタント</strong>
            </p>
            <p class="mb-0" style="font-size: 0.85rem; opacity: 0.9;">
                Microsoft Foundry Agent Service を使用
            </p>
            <p class="mb-0 mt-2" style="font-size: 0.75rem; opacity: 0.7;">
                © 2026 AI ドキュメントアシスタント. All rights reserved.
            </p>
        </div>
    </footer>
</div>

<div id="blazor-error-ui">
    予期しないエラーが発生しました。
    <a href="" class="reload">再読み込み</a>
    <a class="dismiss">🗙</a>
</div>

